#!/bin/sh
# ==============================================================================
# Pre-commit común del kit de agentes (se comparte entre proyectos vía mcp-ia).
#
# NO lo edites en un proyecto para una regla propia: esas van en
# .githooks/pre-commit.local (se ejecuta en el Gate 5). Si mejoras este archivo,
# compártelo con `kit_agentes.py hooks <proyecto> --compartir` para que llegue
# a los demás proyectos.
#
# Gates:
#   0 Formato automático de los .dart del commit
#   1 Secretos y archivos sensibles
#   2 Conflictos, depuración, bypass SSL, funciones repetidas y sintaxis JS/GS
#   3 dart format (comprobación)
#   4 flutter/dart analyze de los .dart del commit
#   5 Reglas del proyecto (.githooks/pre-commit.local)
#   6 Pruebas asociadas a los .dart del commit
#
# SKIP_PRE_COMMIT=1 omite los gates, pero .githooks/obligatorio.sh (si existe)
# se ejecuta siempre.
# ==============================================================================

HOOKS_DIR=$(dirname "$0")

if [ "$SKIP_PRE_COMMIT" = "1" ]; then
  echo "⚠️ [PRE-COMMIT] SKIP_PRE_COMMIT=1 detectado. Omitiendo Quality Gates, excepto los obligatorios."
  if [ -f "$HOOKS_DIR/obligatorio.sh" ]; then
    sh "$HOOKS_DIR/obligatorio.sh" || exit 1
  fi
  exit 0
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo "${BLUE}${BOLD}🔍 Quality Gates: Ejecutando verificaciones pre-commit...${NC}"
echo "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "${GREEN}ℹ️ No hay archivos modificados en el área de preparación (staging).${NC}"
  exit 0
fi

STAGED_DART_FILES=$(echo "$STAGED_FILES" | grep '\.dart$' || true)
STAGED_JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|gs)$' || true)

# Herramientas de Dart: flutter si el proyecto depende del SDK de Flutter.
if [ -f pubspec.yaml ] && grep -Eq '^[[:space:]]+sdk:[[:space:]]*flutter' pubspec.yaml; then
  DART_TOOL=flutter
else
  DART_TOOL=dart
fi

# ------------------------------------------------------------------------------
# GATE 0: Formato automático de los .dart del commit
# ------------------------------------------------------------------------------
# Formatea y vuelve a añadir solo los archivos preparados completos. Si uno
# está preparado a medias (git add -p) y sin formato, se detiene el commit:
# volver a añadirlo metería cambios que el autor dejó fuera.
if [ -n "$STAGED_DART_FILES" ]; then
  echo "\n${BLUE}✎  [Gate 0/7] Formato automático: aplicando dart format a los archivos del commit...${NC}"
  PARTIAL=""
  while IFS= read -r file; do
    [ -f "$file" ] || continue
    if ! git diff --quiet -- "$file"; then
      if ! dart format --output=none --set-exit-if-changed "$file" >/dev/null 2>&1; then
        PARTIAL="$PARTIAL
  • $file"
      fi
      continue
    fi
    if ! OUTPUT=$(dart format "$file" 2>&1); then
      echo "${RED}${BOLD}❌ ERROR DE FORMATO:${NC} ${RED}dart format no pudo procesar $file:${NC}"
      echo "$OUTPUT" | sed 's/^/     /'
      exit 1
    fi
    echo "$OUTPUT" | grep -q '(1 changed)' && echo "  ✎ Formateado: $file"
    git add -- "$file" || exit 1
  done <<EOF
$STAGED_DART_FILES
EOF
  if [ -n "$PARTIAL" ]; then
    echo "${RED}${BOLD}❌ FORMATO INCOMPLETO:${NC} ${RED}archivos preparados a medias sin formatear:$PARTIAL${NC}"
    echo "${YELLOW}👉 Formatéalos a mano (dart format <archivo>) y vuelve a prepararlos.${NC}"
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# GATE 1: Secretos y archivos sensibles (OWASP MASVS)
# ------------------------------------------------------------------------------
echo "\n${BLUE}🛡️  [Gate 1/7] Seguridad: Escaneando archivos sensibles y secretos...${NC}"

FORBIDDEN_FILES_PATTERN='(\.env|\.env\..*|\.jks|\.keystore|key\.properties|id_rsa|\.pem|\.key|serviceAccountKey.*\.json|\.mcp\.json|\.clasprc\.json)$'
SENSITIVE_COMMITS=$(echo "$STAGED_FILES" | grep -E "$FORBIDDEN_FILES_PATTERN" || true)

if [ -n "$SENSITIVE_COMMITS" ]; then
  echo "${RED}${BOLD}❌ ERROR DE SEGURIDAD:${NC} ${RED}se intentó commitear archivos sensibles o claves privadas:${NC}"
  for file in $SENSITIVE_COMMITS; do
    echo "  ${RED}• $file${NC}"
  done
  echo "${YELLOW}👉 Retíralos del staging con: git reset HEAD <archivo>${NC}"
  exit 1
fi

for file in $STAGED_FILES; do
  if [ -f "$file" ] && grep -Eq -- '-----BEGIN ([A-Z0-9_-]+ )?PRIVATE KEY' "$file" 2>/dev/null; then
    echo "${RED}${BOLD}❌ ERROR DE SEGURIDAD: Clave privada detectada en $file${NC}"
    exit 1
  fi
done

echo "${GREEN}  ✓ No se detectaron archivos sensibles ni claves expuestas.${NC}"

# ------------------------------------------------------------------------------
# GATE 2: Integridad del código
# ------------------------------------------------------------------------------
echo "\n${BLUE}🧹 [Gate 2/7] Integridad: conflictos, depuración y nombres repetidos...${NC}"

CONFLICT_FOUND=0
for file in $STAGED_FILES; do
  if [ -f "$file" ] && grep -Eq '^(<{7}|={7}|>{7})( |$)' "$file" 2>/dev/null; then
    echo "${RED}${BOLD}❌ ERROR DE INTEGRIDAD: Marcador de conflicto de merge en $file${NC}"
    CONFLICT_FOUND=1
  fi
done
if [ "$CONFLICT_FOUND" -ne 0 ]; then
  echo "${YELLOW}👉 Corrige los conflictos pendientes antes de realizar el commit.${NC}"
  exit 1
fi

for file in $STAGED_DART_FILES; do
  [ -f "$file" ] || continue
  if grep -Eq '\bdebugger\s*\(' "$file" 2>/dev/null; then
    echo "${RED}❌ ERROR: Llamada a 'debugger()' detectada en $file${NC}"
    exit 1
  fi
  if grep -Eq 'badCertificateCallback.*=>\s*true' "$file" 2>/dev/null; then
    echo "${RED}${BOLD}❌ ERROR DE SEGURIDAD: Bypass SSL inseguro (badCertificateCallback => true) en $file${NC}"
    exit 1
  fi
done

# JavaScript / Apps Script: redeclarar una función no da error; gana la última
# y rompe en silencio a quien llamaba a la primera.
repetidas() {
  grep -hoE '^[[:space:]]*(async[[:space:]]+)?function[[:space:]]+[A-Za-z_$][A-Za-z0-9_$]*[[:space:]]*\(' "$@" 2>/dev/null \
    | sed -E 's/.*function[[:space:]]+([A-Za-z0-9_$]+).*/\1/' | sort | uniq -d
}
for file in $STAGED_JS_FILES; do
  [ -f "$file" ] || continue
  DUP=$(repetidas "$file")
  if [ -n "$DUP" ]; then
    echo "${RED}${BOLD}❌ FUNCIONES REPETIDAS en $file:${NC} ${RED}$(echo $DUP)${NC}"
    echo "${YELLOW}👉 Renombra una o reutiliza la existente (gana la última declarada).${NC}"
    exit 1
  fi
  if command -v node >/dev/null 2>&1 && ! node --check < "$file" >/dev/null 2>&1; then
    echo "${RED}${BOLD}❌ ERROR DE SINTAXIS en $file${NC} ${RED}(node --check):${NC}"
    node --check < "$file" 2>&1 | grep -vE '^\s*at |^Node\.js' | head -8
    exit 1
  fi
done
# Los .gs de Apps Script comparten un único ámbito global.
if echo "$STAGED_JS_FILES" | grep -q '\.gs$'; then
  ALL_GS=$(git ls-files '*.gs')
  # shellcheck disable=SC2086
  DUP=$(repetidas $ALL_GS)
  if [ -n "$DUP" ]; then
    echo "${RED}${BOLD}❌ FUNCIONES REPETIDAS entre los .gs del proyecto:${NC} ${RED}$(echo $DUP)${NC}"
    echo "${YELLOW}👉 Apps Script comparte el ámbito global: busca con grep -n \"function <nombre>\" *.gs${NC}"
    exit 1
  fi
fi

echo "${GREEN}  ✓ Sin conflictos, depuradores ni funciones repetidas.${NC}"

# ------------------------------------------------------------------------------
# GATE 3: dart format (comprobación)
# ------------------------------------------------------------------------------
if [ -n "$STAGED_DART_FILES" ]; then
  echo "\n${BLUE}📐 [Gate 3/7] Formato: validando dart format...${NC}"
  FORMAT_CHECK_OUTPUT=$(echo "$STAGED_DART_FILES" | tr '\n' '\0' | xargs -0 dart format --output=none --set-exit-if-changed 2>&1)
  if [ $? -ne 0 ]; then
    echo "${RED}${BOLD}❌ ERROR DE FORMATO:${NC} ${RED}archivos del commit que no cumplen 'dart format':${NC}"
    echo "$FORMAT_CHECK_OUTPUT" | grep '^Changed ' | sed 's/Changed /  • /' || echo "$FORMAT_CHECK_OUTPUT"
    exit 1
  fi
  echo "${GREEN}  ✓ Los archivos Dart del commit cumplen con el formato oficial.${NC}"

# ------------------------------------------------------------------------------
# GATE 4: Análisis estático
# ------------------------------------------------------------------------------
  echo "\n${BLUE}🔬 [Gate 4/7] Análisis estático ($DART_TOOL analyze)...${NC}"
  # shellcheck disable=SC2086
  if ! $DART_TOOL analyze $STAGED_DART_FILES; then
    echo "${RED}${BOLD}❌ ERROR DE ANÁLISIS ESTÁTICO:${NC} ${RED}corrige las advertencias indicadas arriba.${NC}"
    exit 1
  fi
  echo "${GREEN}  ✓ Análisis estático completado sin errores.${NC}"
fi

# ------------------------------------------------------------------------------
# GATE 5: Reglas propias del proyecto
# ------------------------------------------------------------------------------
# .githooks/pre-commit.local recibe STAGED_FILES y STAGED_DART_FILES (una ruta
# por línea) y TESTS_EXTRA_FILE: puede escribir ahí pruebas para el Gate 6.
TESTS_EXTRA_FILE=$(mktemp)
trap 'rm -f "$TESTS_EXTRA_FILE"' EXIT
if [ -f "$HOOKS_DIR/pre-commit.local" ]; then
  echo "\n${BLUE}🏛️  [Gate 5/7] Reglas del proyecto (.githooks/pre-commit.local)...${NC}"
  export STAGED_FILES STAGED_DART_FILES TESTS_EXTRA_FILE
  sh "$HOOKS_DIR/pre-commit.local" || exit 1
fi

# ------------------------------------------------------------------------------
# GATE 6: Pruebas asociadas
# ------------------------------------------------------------------------------
TESTS_TO_RUN=$(cat "$TESTS_EXTRA_FILE")
for file in $STAGED_DART_FILES; do
  case "$file" in
    test/*_test.dart)
      [ -f "$file" ] && TESTS_TO_RUN="$TESTS_TO_RUN $file"
      ;;
    lib/*.dart)
      REL_PATH=${file#lib/}
      CANDIDATE_TEST="test/$(dirname "$REL_PATH")/$(basename "$REL_PATH" .dart)_test.dart"
      [ -f "$CANDIDATE_TEST" ] && TESTS_TO_RUN="$TESTS_TO_RUN $CANDIDATE_TEST"
      ;;
  esac
done

if [ -n "$(echo $TESTS_TO_RUN)" ]; then
  echo "\n${BLUE}🧪 [Gate 6/7] Pruebas asociadas...${NC}"
  UNIQUE_TESTS=$(echo "$TESTS_TO_RUN" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')
  echo "${CYAN}  Ejecutando:${NC} $UNIQUE_TESTS"
  # shellcheck disable=SC2086
  if ! $DART_TOOL test $UNIQUE_TESTS; then
    echo "${RED}${BOLD}❌ ERROR EN PRUEBAS:${NC} ${RED}las pruebas asociadas a tus cambios fallaron.${NC}"
    exit 1
  fi
  echo "${GREEN}  ✓ Todas las pruebas asociadas pasaron.${NC}"
elif [ -n "$STAGED_DART_FILES" ]; then
  echo "\n${GREEN}  ℹ️ [Gate 6/7] No hay pruebas vinculadas a los archivos del commit.${NC}"
fi

echo "\n${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo "${GREEN}${BOLD}✅ ¡QUALITY GATES SUPERADOS! Commit permitido.${NC}"
echo "${CYAN}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
exit 0
