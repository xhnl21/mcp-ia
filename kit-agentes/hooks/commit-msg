#!/bin/sh
# ==============================================================================
# commit-msg común del kit de agentes (se comparte entre proyectos vía mcp-ia).
# Valida que los mensajes de commit sigan el estándar de Conventional Commits.
# ==============================================================================

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Permitir commits automáticos de merge, revert y fixup/squash
if echo "$COMMIT_MSG" | grep -Eq '^(Merge |Revert |fixup! |squash! )'; then
  exit 0
fi

# Expresión regular para Conventional Commits:
# <type>(<scope>)?: <description>
# El guion va al final de la clase: en POSIX `\-` no lo escapa y lo excluía.
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_./-]+\))?!?: .+$"

if ! echo "$COMMIT_MSG" | grep -Eq "$PATTERN"; then
  echo "\n\033[0;31m❌ ERROR: El mensaje de commit no cumple con Conventional Commits.\033[0m"
  echo "\nFormato requerido:"
  echo "  <tipo>[ámbito opcional]: <descripción corta>"
  echo "\nTipos permitidos:"
  echo "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "\nEjemplos válidos:"
  echo "  feat(auth): add biometric login support"
  echo "  fix(payment): resolve crash on invalid QR code"
  echo "  docs(api): update swagger configuration"
  echo "  chore: update dependencies"
  echo "\nMensaje ingresado:"
  echo "  \033[1;33m\"$COMMIT_MSG\"\033[0m\n"
  exit 1
fi

exit 0
